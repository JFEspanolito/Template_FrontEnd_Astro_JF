---
// Importamos la config y componentes necesarios
import logoImg from "@/assets/astro.svg";
import configProject from "@/data/configProject";

const year = new Date().getFullYear();
const supportEmail = configProject?.support?.email || null;
const faviconUrl = logoImg;
---

<footer class="relative flex items-center justify-center font-sans bg-background text-foreground">
  <div class="w-full max-w-6xl mx-auto py-8">
    <div class="flex lg:items-start md:flex-row md:flex-nowrap flex-wrap flex-col">
      {/* Brand Section */}
      <div class="w-64 flex-shrink-0 md:mx-0 mx-auto text-center md:text-left">
        <a href="/" aria-current="page" class="flex gap-2 justify-center md:justify-start items-center">
          <img src={faviconUrl.src} alt={`${configProject.appName} logo`} class="w-6 h-6" width="24" height="24" />
          <strong class="font-extrabold tracking-tight text-base md:text-lg">
            {configProject.appName}
          </strong>
        </a>

        {configProject.appDescription && <p class="mt-3 text-sm opacity-80">{configProject.appDescription}</p>}

        <p class="mt-4 text-sm">
          Escríbenos a:
          <a href={`mailto:${supportEmail}`} class="text-primary hover:underline ml-1">
            {supportEmail}
          </a>
        </p>

        <p class="mt-3 text-sm opacity-60">
          Copyright © {year} — Todos los derechos reservados.
        </p>
      </div>

      {/* Columns Section */}
      <div class="flex-grow flex flex-wrap justify-center -mb-10 md:mt-0 mt-10 text-center">
        {/* Links Column */}
        <div class="lg:w-1/3 md:w-1/2 w-full px-4">
          <div class="font-semibold tracking-widest text-sm md:text-left mb-3 uppercase opacity-90">LINKS</div>
        </div>

        {/* Legal Column */}
        <div class="lg:w-1/3 md:w-1/2 w-full px-4">
          <div class="font-semibold tracking-widest text-sm md:text-left mb-3 uppercase opacity-90">LEGAL</div>

          <div class="flex flex-col justify-center items-center md:items-start gap-2 mb-10 text-sm">
            <a href="/privacy" class="hover:text-primary transition-colors"> Privacidad</a>
            <a href="/terms" class="hover:text-primary transition-colors">Términos</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
