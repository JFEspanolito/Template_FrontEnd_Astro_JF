---
import { configProject as config } from "@/data/configProject";
import { profile } from "@/data/Profile";

const lang = (Astro.cookies.get("lang")?.value as "es" | "en") || "es";
const profileShow = lang === "es" ? profile.ES : profile.EN;
const year = new Date().getFullYear();

let copyr = "";
if (lang === "es") {
  copyr = config.copyright_es;
} else {
  copyr = config.copyright_en;
}
---

<footer class="border-t border-[var(--border-dim-one)] py-12 mt-12 bg-transparent">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-col md:flex-row justify-between items-center gap-6">
    <p class="text-[10px] uppercase font-bold tracking-widest text-[var(--foreground-muted)] opacity-60">
      &copy; {year}
      {config.appName}. {profileShow.title}.
    </p>
    <p class="text-[10px] uppercase font-bold tracking-widest text-[var(--foreground-muted)] opacity-60">
      &copy; {year}
      {copyr}.
    </p>
  </div>
</footer>
