---
// Importando Estilos
import "@/styles/global.css";
import { Toaster } from "sileo";
import VerticalMenu from "./VerticalMenu.astro";

// Importando Datos
import { configProject as config } from "@/data/configProject";

// Importando Componentes
import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import AnalyticsBanner from "@/components/analytics/AnalyticsBanner";
import Meta from "@/components/analytics/Meta.astro";

// Propiedades
interface Props {
  title?: string;
}

const { title } = Astro.props;
const finalTitle = title || config.appName;

// Language from cookie for dynamic lang attribute
const lang = (Astro.cookies.get("lang")?.value as "es" | "en") || "es";
const htmlLang = lang === "es" ? "es" : "en";

// Theme from cookie: SSR applies data-theme on first byte → zero FOUC
// If no cookie or "system", we omit data-theme so CSS @media kicks in
const cookieTheme = Astro.cookies.get("theme")?.value || "";
const validThemes = ["default", "dark", "black", "pink", "blue", "yellow"];
const dataTheme = validThemes.includes(cookieTheme) ? cookieTheme : "";
---

<!doctype html>
<html lang={htmlLang} data-theme={dataTheme || undefined}>
  <head>
    <Meta title={finalTitle} />

    <script is:inline define:vars={{ dataTheme }}>
      // If no data-theme from SSR cookie, check localStorage for stored preference
      if (!dataTheme) {
        const stored = localStorage.getItem("theme");
        if (stored && ["default", "dark", "black", "pink", "blue", "yellow"].includes(stored)) {
          document.documentElement.setAttribute("data-theme", stored);
        }
        // Otherwise, no data-theme → CSS @media prefers-color-scheme handles it
      }
    </script>
  </head>

  <body
    class="antialiased bg-[var(--body-background)] text-[var(--foreground-color)] flex flex-col min-h-screen selection:bg-[var(--highlight-one)] selection:text-black"
  >
    <Header />
    <Toaster client:only="react" position="top-center" />

    <main class="flex-grow w-full px-6 lg:px-12 py-12 md:py-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-20">
        <VerticalMenu />
        <slot />
      </div>
    </main>

    <Footer />
    <AnalyticsBanner client:load />
  </body>
</html>
