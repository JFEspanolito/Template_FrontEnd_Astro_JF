---
// Importando Estilos
import "@/styles/global.css";

// Importando Datos
import config from "@/data/configProject";

// Importando Componentes
import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import AnalyticsBanner from "@/components/analytics/AnalyticsBanner";

// Propiedades
interface Props {
  title?: string;
}

const { title } = Astro.props;
// Lógica para que el título sea "Página | AppName" o solo "AppName"
const finalTitle = title ? `${title} | ${config.appName}` : config.appName;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Aquí usamos tu variable calculada */}
    <title>{finalTitle}</title>

    {/* Meta tags globales desde tu config */}
    <meta name="description" content={config.appDescription} />
    <meta name="theme-color" content={config.themeColor} />
    <meta name="generator" content={Astro.generator} />

    {/* Open Graph (Redes Sociales) */}
    <meta property="og:site_name" content={config.appName} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={config.appDescription} />
    <meta
      property="og:image"
      content={config.siteUrl + config.images.ogDefault}
    />
  </head>

  <body
    class="antialiased bg-[var(--background)] text-[var(--foreground)] flex flex-col min-h-screen"
  >
    {/* Header en la parte superior */}
    <Header />

    <main class="flex-grow">
      <slot />
    </main>

    {/* Footer al final */}
    <Footer />
    <AnalyticsBanner client:load />
  </body>
</html>
