---
import { Image } from "astro:assets";
import bbnnLogo from "../../assets/profile.webp";
import { profile } from "@/data/Profile";

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);

const isActive = (path: string) => {
  if (path === "" && currentPath === "") return true;
  if (path !== "" && currentPath.startsWith(path)) return true;
  return false;
};

const activeClass = "text-[var(--foreground-highlight-one)] border-l-2 border-[var(--highlight-one)]";
const inactiveClass = "text-[var(--foreground-muted)] hover:text-[var(--foreground-color)] border-l-2 border-transparent hover:border-white/20";

import { useTranslations } from "@/i18n/ui";
const lang = (Astro.cookies.get("lang")?.value as "es" | "en") || "es";
const t = useTranslations(lang);

const profileShow = lang === "es" ? profile.ES : profile.EN;
---

<aside class="md:col-span-4 lg:col-span-3 space-y-10 md:sticky md:top-32 self-start md:ml-0">
  <div class="flex flex-col items-start space-y-6">
    <div
      class="relative w-24 h-24 grayscale hover:grayscale-0 transition-all duration-500 rounded-full overflow-hidden border-2 border-[var(--border-dim-one)] hover:border-[var(--highlight-one)] bg-[var(--card-background)]"
    >
      <Image src={bbnnLogo} alt="Logo" class="object-contain" />
    </div>
    <div class="space-y-2">
      <h2 class="font-display font-bold text-3xl editorial-title text-[var(--foreground-color)]">
        {profile.name}
      </h2>

      {
        profileShow.description.map((line) => (
          <p class="text-[14px] text-[var(--foreground-muted)] leading-relaxed font-normal max-w-xs">{line}</p>
        ))
      }

      <p class="text-[14px] text-[var(--foreground-muted)] leading-relaxed font-normal max-w-xs">{profileShow.headline}</p>
    </div>
    <div class="w-12 h-1 bg-[var(--highlight-one)]"></div>
  </div>
  <nav class="hidden md:flex flex-col space-y-2">
    <a
      class={`group flex items-center gap-3 py-2 text-sm font-bold nav-link pl-4 transition-all ${isActive("") ? activeClass : inactiveClass}`}
      href="/"
    >
      {t("nav.menu1")}
    </a>
    <a
      class={`group flex items-center gap-3 py-2 text-sm font-bold nav-link pl-4 transition-all ${isActive("CV") ? activeClass : inactiveClass}`}
      href="/CV"
    >
      {t("nav.menu2")}
    </a>
  </nav>
</aside>
