---
import { configProject as config } from "@/data/configProject";

interface Props {
  title: string;
}

const { title } = Astro.props;

// se recomienda qué las imagenes sean de 1200x630px para OG y 1024x512px para Twitter
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" href="/cover/favicon.ico" sizes="any" />
<link rel="icon" type="image/svg+xml" href="/PageCover/favicon.ico" />

<title>{title}</title>

<meta name="description" content={config.appDescription} />
<meta name="theme-color" content={config.themeColor} />
<meta name="generator" content={Astro.generator} />

{/* Open Graph / Facebook */}
<meta property="og:url" content={config.siteUrl + "/"} />
<meta property="og:type" content="website" />
<meta property="og:title" content={config.ogTitle} />
<meta property="og:description" content={config.ogDescription} />
<meta property="og:image" content={config.siteUrl + config.images.ogDefault} />

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta property="twitter:domain" content={config.domainName} />
<meta property="twitter:url" content={config.siteUrl + "/"} />
<meta name="twitter:title" content={config.ogTitle} />
<meta name="twitter:description" content={config.ogDescription} />
<meta name="twitter:image" content={config.siteUrl + config.images.twitterCard} />

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
