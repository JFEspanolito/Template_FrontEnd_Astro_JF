---
import Layout from "../layouts/Layout.astro";
import ButtonBasic from "@/components/buttons/ButtonBasic.astro";
---

<Layout title="Home Page">
  <div class="relative flex items-center justify-center font-sans bg-background text-foreground">
    <div class="w-full max-w-3xl mx-auto px-8 py-24">
      Hola!

      <ButtonBasic id="mi-boton-alerta" title="Entrar" typeButton={1} size={1} />

      <!-- <CtaButton
    client:load
    audioSrc={heyListenAudio}
    propType="success"
    propFill="var(--color-card-bg )"
    buttonClic={{
      title: lang === "en" ? "Email" : "Correo",
      url: aboutData.contact.find((c) => c.name === "Email")?.url,
    }}
    propDesc={lang === "en" ? "Send me a mail or use other social media" : "Envíame un correo o usa otra red social"}
    propTitle={profileInfo.callToAction}
  /> -->
    </div>
  </div>

  <script is:inline>
    function bindAlertButton() {
      const btn = document.getElementById("mi-boton-alerta");

      if (!(btn instanceof HTMLButtonElement) || btn.dataset.alertBound === "true") {
        return;
      }

      btn.dataset.alertBound = "true";
      btn.addEventListener("click", () => {
        alert("¡Funciona sin React y carga volando! 🚀");
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bindAlertButton, { once: true });
    } else {
      bindAlertButton();
    }

    document.addEventListener("astro:page-load", bindAlertButton);
  </script>
</Layout>
