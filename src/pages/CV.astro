---
// Importando Datos
import { configProject as config } from "@/data/configProject";
import { CV as CVdata } from "@/data/CV";

// Importando Componentes
import Layout from "@/layouts/Layout.astro";

// Importando Context
import { useTranslations } from "@/i18n/ui";
const lang = (Astro.cookies.get("lang")?.value as "es" | "en") || "es";
const t = useTranslations(lang);

const experiences = lang === "es" ? CVdata.ES.workExperience : CVdata.EN.workExperience;
const education = lang === "es" ? CVdata.ES.education : CVdata.EN.education;
---

<Layout title={`${config.tabname} - CV`}>
  <section id="CV" class="md:col-span-8 lg:col-span-9 w-full animate-fade-in">
    {/* Work Experience */}
    <div class="w-full">
      <h2 class="text-3xl font-display font-bold flex mb-4 text-[var(--foreground-color)] justify-start">
        {t("cv.workExperience")}
      </h2>
      <div class="w-20 h-1 bg-[var(--highlight-one)] mb-12"></div>

      <div class="relative border-l-2 border-white/5 ml-3 space-y-16 pb-12 w-full">
        {
          experiences.map((exp) => (
            <div class="relative pl-12 group">
              {/* Timeline Dot */}
              <div class="absolute -left-[11px] top-1.5 w-5 h-5 bg-bg-base border-2 rounded-full border-[var(--highlight-one)] transition-colors z-10 flex items-center justify-center">
                <div class="w-2 h-2 bg-[var(--highlight-one)] rounded-full opacity-100 group:opacity-100 transition-opacity" />
              </div>

              {/* Content Container */}
              <div class="w-full flex flex-col">
                <div class="flex flex-wrap items-center gap-4 mb-3">
                  <h3 class="text-2xl md:text-3xl font-bold text-[var(--foreground-color)] tracking-tight leading-none">{exp.company}</h3>
                </div>

                <p class="text-[var(--foreground-muted)] text-sm font-medium mb-6 tracking-wide">{exp.date}</p>

                <p class="text-[var(--foreground-highlight-one)]/90 leading-relaxed text-lg mb-8 max-w-none">{exp.description}</p>

                {/* Nested Projects */}
                {exp.projects && (
                  <div class="space-y-10 mt-4 border-l border-white/5 pl-8 md:max-w-[calc(100%-5rem)]">
                    {exp.projects.map((project) => (
                      <div class="relative group/project">
                        <div class="absolute -left-[37px] top-3 w-4 h-[2px] bg-white/10 group-hover/project:bg-accent-neon transition-colors" />
                        <h4 class="text-[var(--foreground-color)] font-bold text-xl mb-2 group-hover/project:text-accent-cyan transition-colors">
                          {project.name}
                        </h4>
                        <p class="text-[var(--foreground-highlight-one)]/50 font-mono text-xs uppercase tracking-widest mb-3">
                          {project.details}
                        </p>
                        <p class="text-[var(--foreground-muted)]/80 text-base leading-relaxed md:max-w-[calc(100%-6rem)] 2xl:max-w-[120ch]">
                          {project.description}
                        </p>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    {/* Education */}
    <div class="w-full mt-16">
      <h2 class="text-3xl font-display font-bold flex mb-4 text-[var(--foreground-color)] justify-start">
        {t("cv.education")}
      </h2>
      <div class="w-20 h-1 bg-[var(--highlight-one)] mb-12"></div>

      <div class="relative border-l-2 border-white/5 ml-3 space-y-16 pb-12 w-full">
        {
          education.map((exp) => (
            <div class="relative pl-12 group">
              {/* Timeline Dot */}
              <div class="absolute -left-[11px] top-1.5 w-5 h-5 bg-bg-base border-2 rounded-full border-[var(--highlight-one)] transition-colors z-10 flex items-center justify-center">
                <div class="w-2 h-2 bg-[var(--highlight-one)] rounded-full opacity-100 group:opacity-100 transition-opacity" />
              </div>

              {/* Content Container */}
              <div class="w-full flex flex-col">
                <div class="flex flex-wrap items-center gap-4 mb-3">
                  <h3 class="text-2xl md:text-3xl font-bold text-[var(--foreground-color)] tracking-tight leading-none">{exp.title}</h3>
                </div>

                <p class="text-[var(--foreground-highlight-one)]/90 leading-relaxed text-lg max-w-none">{exp.institution}</p>
                <p class="text-[var(--foreground-muted)] text-sm font-medium tracking-wide">{exp.date}</p>
                <p class="text-[var(--foreground-highlight-one)]/50 leading-relaxed text-lg max-w-none">{exp.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .material-symbols-outlined {
    font-variation-settings:
      "FILL" 1,
      "wght" 400,
      "GRAD" 0,
      "opsz" 24;
  }
</style>
